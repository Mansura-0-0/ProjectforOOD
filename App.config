<?xml version="1.0" encoding="utf-8"?>
<configuration>

	<connectionStrings>
		<add name="TaskDb" connectionString="Data Source=tasks.db;Version=3;" providerName="System.Data.SQLite.EF6" />
	</connectionStrings>

	<system.data>
		<DbProviderFactories>
			<remove invariant="System.Data.SQLite.EF6" />
			<add name="SQLite Data Provider" invariant="System.Data.SQLite.EF6" description=".NET Framework Data Provider for SQLite" type="System.Data.SQLite.EF6.SQLiteProviderFactory, System.Data.SQLite.EF6" />
		</DbProviderFactories>
	</system.data>

  <runtime>

    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">

      <dependentAssembly>

        <assemblyIdentity name="System.Memory" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />

        <bindingRedirect oldVersion="0.0.0.0-4.0.5.0" newVersion="4.0.5.0" />

      </dependentAssembly>

    </assemblyBinding>

  </runtime>
</configuration>